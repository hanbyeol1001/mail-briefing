# .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# Sentry 프로젝트 설정 > Client Keys (DSN) 에서 복사
SENTRY_DSN=

# Sentry 에 보이는 사용자 별칭 (이름/이메일 금지). 예: user-1, user-2
MAILBRIEF_USER_ALIAS=user-1

# dev 또는 prod
SENTRY_ENVIRONMENT=dev

# ── 회사 값 (코드에는 적지 않음. 배포 exe 를 만들 때 이 값이 exe 안에 들어감) ──
# 그룹웨어 주소. 예: https://groupware.example.com
GROUPWARE_URL=

# 사내망에서 그룹웨어가 쓰는 사내 IP (선택). 브라우저 보안 DNS 가 외부 주소를 줄 때 대신 씀.
GROUPWARE_IP=

# 다른 시스템에서 바로 열어 보는 알림 메일을 알아볼 말 (보낸 사람·제목, 쉼표로 여러 개, 선택)
ALERT_WORDS=

# 자동 실행 시각(월~토 07:50)을 Sentry 가 셀 시간대. IANA 이름. 예: Asia/Seoul (비우면 UTC)
TIMEZONE=

# 브리핑에서 늘 뺄 보낸 사람 / 제목에 든 말 (쉼표로 여러 개, 선택). 설정 창에서 더 넣을 수 있음.
EXCLUDE_SENDERS=
EXCLUDE_SUBJECTS=
